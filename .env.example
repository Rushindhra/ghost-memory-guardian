# Copy to .env (backend reads it from the folder it is started in, or set real environment variables).
# Every value below is the default; uncomment only what you want to change.

# --- storage ---
# GHOST_DATA_DIR=./data
# GHOST_MODELS_DIR=./models
# GHOST_MAX_UPLOAD_MB=200

# --- local language model (Ollama) ---
# GHOST_OLLAMA_URL=http://127.0.0.1:11434
# GHOST_LLM_MODEL=qwen3:4b          # any model shown by `ollama list`; try qwen3:1.7b on low-RAM machines
# GHOST_LLM_TIMEOUT_S=240
# GHOST_ALLOW_REMOTE_LLM=false      # leave false: refuses to send memories to a non-local Ollama

# --- embeddings / search ---
# GHOST_EMBED_BACKEND=auto          # auto | sentence-transformers | lexical (lexical = no model needed)
# GHOST_EMBED_MODEL_PATH=./models/embeddings/multilingual-e5-small
# GHOST_MIN_SCORE=                  # optional; calibrate with `python scripts/evaluate.py --calibrate`

# --- transcription (faster-whisper) ---
# GHOST_WHISPER_MODEL_PATH=./models/whisper/base
# GHOST_WHISPER_LANGUAGE=           # blank = auto-detect; e.g. en, hi, es
# GHOST_WHISPER_COMPUTE_TYPE=int8

# --- web ---
# GHOST_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# GHOST_SESSION_HOURS=12
